10 REM ==========================================
20 REM  ELIZA - CLASSIC PSYCHOTHERAPIST (GW-BASIC)
30 REM ==========================================
40 PRINT "ELIZA: HELLO. I AM YOUR DOCTOR. WHAT IS YOUR PROBLEM?"
50 INPUT "> "; USER$
60 IF USER$ = "BYE" OR USER$ = "QUIT" THEN PRINT "ELIZA: GOODBYE. TAKE CARE.": END
70 IF INSTR(USER$, "MOTHER") > 0 THEN PRINT "ELIZA: TELL ME MORE ABOUT YOUR FAMILY.": GOTO 50
80 IF INSTR(USER$, "FATHER") > 0 THEN PRINT "ELIZA: HOW WAS YOUR RELATIONSHIP WITH YOUR FATHER?": GOTO 50
90 IF INSTR(USER$, "WHY") > 0 THEN PRINT "ELIZA: WHY DO YOU THINK THAT IS?": GOTO 50
100 IF INSTR(USER$, "I FEEL") > 0 THEN PRINT "ELIZA: DO YOU OFTEN FEEL THAT WAY?": GOTO 50
110 IF INSTR(USER$, "YES") > 0 THEN PRINT "ELIZA: YOU SEEM QUITE CERTAIN.": GOTO 50
120 IF INSTR(USER$, "NO") > 0 THEN PRINT "ELIZA: WHY NOT?": GOTO 50
130 PRINT "ELIZA: PLEASE GO ON. I AM LISTENING."
140 GOTO 50
