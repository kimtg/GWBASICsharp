10 REM ==========================================
20 REM  LUNAR LANDER SIMULATION (GW-BASIC)
30 REM ==========================================
40 PRINT "LUNAR LANDER SIMULATION"
50 PRINT "-----------------------"
60 ALT = 1000: VEL = 50: FUEL = 500: GRAV = 5
70 WHILE ALT > 0
80   PRINT USING "ALTITUDE: #### FT  VELOCITY: ### FT/S  FUEL: ### LBS"; ALT; VEL; FUEL
90   INPUT "ENTER FUEL TO BURN (0 TO 50)"; BURN
100  IF BURN < 0 THEN BURN = 0
110  IF BURN > 50 THEN BURN = 50
120  IF BURN > FUEL THEN BURN = FUEL
130  FUEL = FUEL - BURN
140  VEL = VEL + GRAV - (BURN * 0.4)
150  ALT = ALT - VEL
160  IF ALT < 0 THEN ALT = 0
170 WEND
180 PRINT
190 PRINT "TOUCHDOWN!"
200 PRINT USING "FINAL VELOCITY: ###.## FT/S"; VEL
210 IF VEL <= 5 THEN PRINT "PERFECT LANDING! WELCOME TO THE MOON!": PLAY "T180 O4 L8 C E G O5 C4" : GOTO 250
220 IF VEL <= 15 THEN PRINT "ROUGH LANDING, BUT CREW SURVIVED!": PLAY "T120 O3 L4 G E C" : GOTO 250
230 PRINT "CRASH! CRATER FORMED ON THE LUNAR SURFACE!": BEEP: PLAY "T80 O2 L4 C P8 O1 G2"
240 REM END
250 END
